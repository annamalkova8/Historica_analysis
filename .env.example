# Database: add Neon Postgres from the Vercel Marketplace (Storage tab) - it sets DATABASE_URL for you.
DATABASE_URL=postgres://...
# Login password for the hub (required)
APP_PASSWORD=choose-a-long-password
# Optional: secret used to sign the login cookie (defaults to APP_PASSWORD)
SESSION_SECRET=
# OpenAI key (same one as the grant bot); uses the Responses API with the web_search tool
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# How many sources each service checks per daily cron run (default 3)
CRON_CHUNK=3
