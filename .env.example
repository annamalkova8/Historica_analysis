# Database: add Neon Postgres from the Vercel Marketplace (Storage tab) - it sets DATABASE_URL for you.
DATABASE_URL=postgres://...
# Login password for the hub (required)
APP_PASSWORD=choose-a-long-password
# Optional: secret used to sign the login cookie (defaults to APP_PASSWORD)
SESSION_SECRET=
# OpenAI key (same one as the grant bot); uses the Responses API with the web_search tool
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano
OPENAI_REASONING_EFFORT=low
# Vercel Cron sends this as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# How many sources each service checks per daily cron run (default 3)
CRON_CHUNK=3

# --- Jira (Project progress + Team performance pages). Read-only. Leave empty to keep Jira disabled. ---
JIRA_BASE_URL=https://historica.atlassian.net/jira/software/projects/DEV/boards/2?filter=&groupBy=assignee
JIRA_EMAIL=info@historica.org
# Create at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN='ATATT3xFfGF0wOvAYN96HsnZBlWnRa8biKpn4tSfwQx3QTbZUIEgmhZGpcN-yxFRKlad7b-vlR_lZDr_G7vLcFBVLnxz_5qXcVKO0lqc2mZ49R5TAHYCfWD7ETivhHsVPpPPIfigZLc5v_vEh1pAeEAQVF92V5UyJO63ozmX1jWxlIXiviZjiRc=66F116D4'
# Project key (e.g. HIS) - or set JIRA_JQL for a custom filter, e.g. project = HIS AND created >= -180d
JIRA_PROJECT='Historica tech'
JIRA_JQL=
# Optional: custom field id holding story points (default customfield_10016)
JIRA_STORY_POINTS_FIELD=
